  generator client {
    provider = "prisma-client"
    output   = "../src/generated"
  }

  datasource db {
    provider = "postgresql"
  }

  model User {
    id String @id @default(uuid())

    nickname String @unique()
    role     Role   @default(USER)

    email    String @unique
    password String

    novels      Novel[]
    savedNovels SavedNovels[]
    comments    Comment[]
    bookmarks   Bookmark[]

    novelRates   NovelRate[]
    commentRates CommentRate[]

    canComment  Boolean @default(true) @map("can_comment")
    canAddNovel Boolean @default(true) @map("can_add_novel")

    createdAt DateTime @default(now()) @map("created_at")

    @@map("users")
  }

  model Novel {
    id String @id @default(uuid())

    title       String @unique
    description String
    imagePath   String @map("image_path")
    language    Lang

    genres NovelGenre[]

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @map("user_id")

    chapters    Chapter[]
    comments    Comment[]
    rates       NovelRate[]
    savedNovels SavedNovels[]
    bookMarks   Bookmark[]

    translations NovelTranslation[]

    avgRate Float @default(0)

    isHidden  Boolean  @default(false) @map("is_hidden")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @map("updated_at")

    @@map("novels")
  }

  model NovelGenre {
    novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
    novelId String @map("novel_id")

    genre Genre

    @@id([novelId, genre])
    @@map("novel_genres")
  }

  model SavedNovels {
    novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
    novelId String @map("novel_id")

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @map("user_id")

    @@id([novelId, userId])
    @@map("saved_novels")
  }

  model Chapter {
    id String @id @default(uuid())

    title String
    text  String

    chapterNumber Int @map("chapter_number")

    novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
    novelId String @map("novel_id")

    bookmarks    Bookmark[]
    translations ChapterTranslation[]

    updatedAt DateTime @updatedAt @map("updated_at")
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([chapterNumber, novelId])
    @@map("chapters")
  }

  model NovelTranslation {
    id String @id @default(uuid())

    title       String @unique
    description String
    language    Lang

    novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
    novelId String @map("novel_id")

    @@unique([novelId, language])
    @@map("novel_translations")
  }

  model ChapterTranslation {
    title    String
    text     String
    language Lang

    chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
    chapterId String  @map("chapter_id")

    updatedAt DateTime @updatedAt @map("updated_at")
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([chapterId, language])
    @@map("chapter_translations")
  }

  model Bookmark {
    chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
    chapterId String  @map("chapter_id")

    novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
    novelId String @map("novel_id")
    user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId  String @map("user_id")

    @@unique([novelId, userId])
    @@map("bookmarks")
  }

  model Comment {
    id String @id @default(uuid())

    text String

    novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
    novelId String @map("novel_id")
    user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId  String @map("user_id")

    rates CommentRate[]

    isHidden  Boolean  @default(false) @map("is_hidden")
    createdAt DateTime @default(now()) @map("created_at")

    @@map("comments")
  }

  model NovelRate {
    novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
    novelId String @map("novel_id")
    user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId  String @map("user_id")

    rate Int

    @@unique([userId, novelId])
    @@map("novel_rates")
  }

  model CommentRate {
    comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
    commentId String  @map("comment_id")
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String  @map("user_id")

    isPositive Boolean @map("is_positive")

    @@unique([userId, commentId])
    @@map("comment_rates")
  }

  enum Role {
    USER
    ADMIN
    SUPERADMIN
  }

  enum Genre {
    FANTASY
    ACTION
    ADVENTURE
    ROMANCE
    DRAMA
    COMEDY
    SCI_FI
    MYSTERY
    HORROR
    SUPERNATURAL
    ISEKAI
    REINCARNATION
    REGRESSION
    SLICE_OF_LIFE
  }

  enum Lang {
    UKRAINIAN
    ENGLISH
  }
