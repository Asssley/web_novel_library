<div class="novel-manage-page">

  <!-- HEADER -->
  <div class="novel-manage-header">

    <a href="/novels/<%= novel.id %>">
      <div class="novel-preview">
        <img src="/images/uploads/<%= novel.imagePath %>" alt="<%= novel.title %>">
      </div>
    </a>

    <div class="novel-main">

      <div class="novel-info">
        <h1 class="novel-title">
          <a href="/novels/<%= novel.id %>">
            <%= novel.title %>
          </a>
        </h1>
        <p class="novel-subtitle">Manage your novel content and chapters</p>
      </div>

      <!-- ACTIONS BAR -->
      <div class="novel-actions-bar">

        <!-- LEFT: main actions -->
        <div class="actions-left">

          <a href="/novels/<%= novel.id %>/chapters/add" class="btn success">
            Add chapter
          </a>

          <a href="/novels/<%= novel.id %>/edit" class="btn primary">
            Edit novel
          </a>

        </div>

        <!-- RIGHT: delete actions -->
        <div class="actions-right">

          <form id="delete-last-chapter-form">
            <button type="submit" class="btn warning">
              Delete last chapter
            </button>
          </form>

          <form id="delete-novel-form">

            <button type="submit" class="btn danger">
              Delete novel
            </button>

          </form>

        </div>

      </div>
    </div>
  </div>


  <!-- CHAPTERS -->
  <div class="chapters-section">

    <h2 class="section-title">Chapters</h2>
    <div>To edit chapters select one from the list below</div>

    <% if (!chapters.length) { %>
    <div class="empty-state">No chapters yet</div>
    <% } else { %>
    <div class="chapters-list">

      <% chapters.forEach(ch => { %>

      <a href="/novels/<%= novel.id %>/chapters/<%= ch.id %>/edit" class="chapter-item">

        <div class="chapter-left">
          <div class="chapter-number">
            <%= ch.chapterNumber %>.
          </div>
  
          <div class="chapter-title">
            <%= ch.title %>
          </div>
        </div>

        <div class="chapter-updated-time">
          <%= ch.updatedAt.toLocaleDateString() %>
        </div>

      </a>

      <% }) %>

    </div>

    <div class="d-flex justify-content-center">
      <%- include("../partials/simple-pagination", {
        pagination: pagination,
        path: `/novels/my/${novel.id}`
      }) %>
    </div>

    <% } %>

  </div>

</div>