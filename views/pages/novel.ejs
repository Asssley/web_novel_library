<div class="novel-page">

  <!-- TOP SECTION -->
  <div class="novel-header">

    <!-- Image -->
    <div class="novel-cover">
      <img src="/images/uploads/<%= novel.imagePath %>" alt="<%= novel.title %>">
    </div>

    <!-- Info -->
    <div class="novel-info">

      <h1 class="novel-title">
        <%= novel.title %>
      </h1>

      <div class="novel-meta">

        <div>
          <span class="meta-label">Author:</span>
          <span><%= novel.user.nickname ?? 'Unknown' %></span>
        </div>

        <div>
          <span class="meta-label">Rating:</span>
          <span>
            <%= novelRate.rate.avg.rate ? novelRate.rate.avg.rate.toFixed(1) : '0.0' %>
            (<%= novelRate.rate.count %>)
          </span>
        </div>

        <div>
          <span class="meta-label">Language:</span>
          <%= novel.language.charAt(0).toUpperCase() + novel.language.slice(1).toLowerCase() %>
        </div>

        <div>
          <span class="meta-label">Chapters:</span>
          <span><%= novel.chaptersCount ?? 0 %></span>
        </div>

        <div>
          <span class="meta-label">Genres:</span>
          <%= novel.genres.map(g => g.toLowerCase()).join(', ') %>
        </div>

      </div>

      <!-- ACTION BUTTONS -->
      <div class="novel-actions">
        <div class="action-row">

          <button class="novel-btn" id="openRatingModal" data-novel-id="<%= novel.id %>">
            Rate novel
          </button>

          <div class="rating-modal hidden" id="ratingModal">

            <div class="rating-modal-content">

              <button class="rating-close" id="closeRatingModal">
                ✕
              </button>

              <h2>Rate this novel</h2>

              <div class="rating-stars" id="ratingStars">

                <button class="star-btn" data-rate="1">☆</button>
                <button class="star-btn" data-rate="2">☆</button>
                <button class="star-btn" data-rate="3">☆</button>
                <button class="star-btn" data-rate="4">☆</button>
                <button class="star-btn" data-rate="5">☆</button>

              </div>

              <div class="rating-success hidden" id="ratingSuccess">
                Thank you for your rating!
              </div>

            </div>

          </div>

          <% if (novel.isSaved) { %>
          <button class="novel-btn save-btn save-btn-saved" id="save-btn" data-novel-id="<%= novel.id %>">
            <i class="bi bi-bookmark-fill"></i>
            <span id="save-btn-label">Saved</span>
          </button>
          <% } else { %>
          <button class="novel-btn save-btn" id="save-btn" data-novel-id="<%= novel.id %>">
            <i class="bi bi-bookmark-fill"></i>
            <span id="save-btn-label">Save</span>
          </button>
          <% } %>

          <!-- If user readed before, show 'kontinue reading' othervise show start reading -->
          <!-- after that check if the last chapter is available, it could be deleted, -->
          <!-- or even has not be added yet -->
          <div>

            <% const buttonText = hasReadBefore
              ? 'Continue reading'
              : 'Start reading'; %>

            <% if (lastChapterId) { %>

            <a href="/novels/<%= novel.id %>/chapters/<%= lastChapterId %>" class="novel-btn">
              <%= buttonText %>
            </a>

            <% } else { %>

            <a href="#" class="novel-btn disable">
              <%= buttonText %>
            </a>

            <% } %>

          </div>
        </div>

      </div>
    </div>
  </div>


  <a href="/novels/<%= novel.id %>/chapters" class="novel-btn chapter-button">
    Chapters
  </a>

  <!-- DESCRIPTION -->
  <div class="novel-description">

    <h2>Description</h2>

    <p>
      <%= novel.description %>
    </p>

  </div>

</div>