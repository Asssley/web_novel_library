<div class="profile-page">

  <!-- TITLE -->
  <h1 class="profile-title">My account</h1>

  <!-- USER INFO CARD -->
  <div class="profile-card">

    <div class="profile-row">
      <span class="label">Nickname</span>
      <span class="value"><%= user.nickname %></span>
    </div>

    <div class="profile-row">
      <span class="label">Email</span>
      <span class="value"><%= user.email %></span>
    </div>

    <div class="profile-row">
      <span class="label">Registered</span>
      <span class="value"><%= new Date(user.createdAt).toLocaleDateString() %></span>
    </div>

  </div>


  <!-- STATS -->
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-number"><%= stats.createdNovels %></span>
      <span class="stat-label">Your novels</span>
    </div>

    <div class="stat-card">
      <span class="stat-number"><%= stats.savedNovels %></span>
      <span class="stat-label">Saved novels</span>
    </div>

    <div class="stat-card">
      <span class="stat-number"><%= stats.ratedNovels %></span>
      <span class="stat-label">Rated novels</span>
    </div>

    <div class="stat-card">
      <span class="stat-number"><%= stats.comments %></span>
      <span class="stat-label">Comments</span>
    </div>

    <div class="stat-card">
      <span class="stat-number"><%= stats.commentLikes %></span>
      <span class="stat-label">Comment likes</span>
    </div>

    <div class="stat-card">
      <span class="stat-number"><%= stats.commentDislikes %></span>
      <span class="stat-label">Comment dislikes</span>
    </div>

  </div>

  <!-- ACTIONS -->
  <div class="profile-actions">

    <a href="/novels/my" class="btn primary">
      Manage your novels
    </a>

    <% if (user.role === "ADMIN" || user.role === "SUPERADMIN") { %>
    <a href="/admin" class="btn danger">
      Admin panel
    </a>
    <% } %>

    <button class="btn logout-btn" id="logoutBtn">
      Logout
    </button>

  </div>

</div>