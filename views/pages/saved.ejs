<div class="library-page">

  <!-- Filters -->

  <div class="library-top-bar">

    <div class="top-bar-label">
      <span>Saved novels</span>
    </div>

    <button class="filters-btn" id="filtersBtn">
      Filters
    </button>

  </div>

  <!-- Modal vindow for filters -->

  <div class="filters-modal hidden" id="filtersModal">
    <div class="filters-content">

      <h3>Filters</h3>

      <form id="filtersForm" method="GET" action="/saved">

        <!-- Sort -->
        <div>
          <label>Sort by</label>

          <select name="sortBy">

            <option value="rates" <%= filters?.sortBy === 'rating' ? 'selected' : '' %>>
              Rating
            </option>
            
            <option value="updatedAt" <%= filters?.sortBy === 'updatedAt' ? 'selected' : '' %>>
              Updated
            </option>

            <option value="createdAt" <%= filters?.sortBy === 'createdAt' ? 'selected' : '' %>>
              Created
            </option>

          </select>
        </div>

        <!-- Order -->
        <div>
          <label>Order</label>

          <select name="order">

            <option value="desc" <%= filters?.order === 'desc' ? 'selected' : '' %>>
              DESC
            </option>

            <option value="asc" <%= filters?.order === 'asc' ? 'selected' : '' %>>
              ASC
            </option>

          </select>
        </div>

        <!-- Aply and submit buttons -->

        <div class="filters-actions">
          <button type="button" class="reset-btn" id="resetFilters">Reset</button>
          <button type="submit" class="apply-btn">Apply</button>
        </div>

      </form>

    </div>
  </div>

  <!-- List of novels -->
  
  <%if (!novels.length) { %>
  <div class="d-flex justify-content-center nothing-found-label">
    Nothing found
  </div>
  <% } else { %>

  <div class="library-grid">

    <% novels.forEach(novel=> { %>

    <a href="/novels/<%= novel.id %>" class="novel-card">

      <div class="novel-image-wrapper">
        <img src="/images/uploads/<%= novel.imagePath %>" alt="<%= novel.title %>" class="novel-image">
      </div>

      <div class="novel-title" title="<%= novel.title %>">
        <%= novel.title %>
      </div>

    </a>

    <% }) %>
  </div>

  <%- include("../partials/novel-pagination", { filters, pagination, path: "/saved"}) %>
  <% } %>
</div>